// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql" // Aap MongoDB ya MySQL bhi use kar sakte hain
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// prisma/schema.prisma

model User {
  id       String    @id @default(uuid())
  username String    @unique
  password String
  contents Content[]
  link     Link? // User ka unique brain share link
}

model Link {
  id     String @id @default(uuid())
  hash   String @unique
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Content {
  id        String   @id @default(uuid())
  title     String
  link      String?
  type      String // 'tweet' | 'video' | 'article' | 'note'
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags   Tag[]
}

model Tag {
  id       String    @id @default(uuid())
  name     String    @unique
  contents Content[]
}
